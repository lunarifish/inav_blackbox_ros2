<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inav_blackbox_ros2</name>
  <version>0.1.0</version>
  <description>
    Convert INAV (and Betaflight) blackbox flight logs into rosbag2 MCAP bags, so
    rviz2, Foxglove Studio and PlotJuggler can be used to debug a flight.
  </description>
  <maintainer email="lunarifish@users.noreply.github.com">lunarifish</maintainer>
  <license>MIT</license>
  <url type="website">https://github.com/iNavFlight/blackbox-tools</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>rcutils</depend>
  <depend>rosidl_runtime_cpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>inav_blackbox_msgs</depend>

  <!-- Storage plugin, selected at run time (mcap is the default). -->
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
